// Typesetter: Distance Field shader, 2D (CanvasItem).
// Generated by tools/make_shaders.py; edit distance_field.gdshaderinc instead.
shader_type canvas_item;
render_mode blend_premul_alpha;

/// Atlas texture (set per surface from the font asset).
uniform sampler2D main_tex : filter_linear, repeat_disable;
#define TS_OUTLINE
#define TS_UNDERLAY
#define TS_GLOW
#define TS_BEVEL
#define TS_TEXTURES
#define TS_MASK
#define TS_TEX main_tex
#include "res://addons/typesetter/shaders/distance_field.gdshaderinc"

varying vec4 v_custom0;
varying vec2 v_local;
varying vec4 v_color;

void vertex() {
	v_custom0 = CUSTOM0;
	v_color = COLOR;
	VERTEX += vec2(vertex_offset_x, -vertex_offset_y);
	v_local = VERTEX;
}

void fragment() {
	float flags = v_custom0.w;
	vec4 c;
	if (mod(floor(flags / 4.0), 2.0) >= 1.0) {
		c = ts_solid(v_color);
	} else if (mod(floor(flags / 2.0), 2.0) >= 1.0) {
		c = texture(TEXTURE, UV) * v_color;
		c.rgb *= c.a;
	} else {
		c = ts_shade(UV, v_color, v_custom0, TIME);
	}
#ifdef TS_MASK
	c *= ts_mask(v_local);
#endif
	COLOR = c;
}
