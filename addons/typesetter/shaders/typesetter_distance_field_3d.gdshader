// Typesetter: Distance Field shader, 3D.
// Generated by tools/make_shaders.py; edit distance_field.gdshaderinc instead.
shader_type spatial;
render_mode unshaded, cull_disabled, blend_premul_alpha, depth_draw_never;

/// Atlas texture (set per surface from the font asset).
uniform sampler2D main_tex : filter_linear, repeat_disable;
#define TS_OUTLINE
#define TS_UNDERLAY
#define TS_GLOW
#define TS_BEVEL
#define TS_TEXTURES
#define TS_MASK
#define TS_INSTANCE_MASK
#define TS_TEX main_tex
#include "res://addons/typesetter/shaders/distance_field.gdshaderinc"
/// Per-node tint (cross_fade_color / cross_fade_alpha).
instance uniform vec4 ts_tint = vec4(1.0);

varying vec4 v_custom0;
varying vec2 v_local;

vec3 ts_to_linear(vec3 c) {
	return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

void vertex() {
	v_custom0 = CUSTOM0;
	VERTEX.xy += vec2(vertex_offset_x, vertex_offset_y);
	v_local = VERTEX.xy;
}

void fragment() {
	vec4 vc = COLOR * ts_tint;
	if (!OUTPUT_IS_SRGB) {
		vc.rgb = ts_to_linear(vc.rgb);
	}
	float flags = v_custom0.w;
	vec4 c;
	if (mod(floor(flags / 4.0), 2.0) >= 1.0) {
		c = ts_solid(vc);
	} else if (mod(floor(flags / 2.0), 2.0) >= 1.0) {
		c = texture(main_tex, UV) * vc;
		c.rgb *= c.a;
	} else {
		c = ts_shade(UV, vc, v_custom0, TIME);
	}
#ifdef TS_MASK
	c *= ts_mask(v_local);
#endif
	ALBEDO = c.rgb;
	ALPHA = c.a;
}
