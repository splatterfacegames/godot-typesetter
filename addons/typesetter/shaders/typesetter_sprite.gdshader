// Typesetter: sprites (inline images), 2D.
// Generated by tools/make_shaders.py; edit distance_field.gdshaderinc instead.
shader_type canvas_item;
render_mode blend_premul_alpha;

varying vec4 v_color;

void vertex() {
	v_color = COLOR;
}

void fragment() {
	vec4 c = texture(TEXTURE, UV) * v_color;
	c.rgb *= c.a;
	COLOR = c;
}
